{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the widget and settings windows",
  "windows": [
    "widget",
    "settings"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
