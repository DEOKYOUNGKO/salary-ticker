{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salary Ticker",
  "version": "0.1.0",
  "identifier": "com.salaryticker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "월급 티커",
        "width": 340,
        "height": 230,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "minimizable": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "월급 티커 설정",
        "width": 420,
        "height": 680,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
